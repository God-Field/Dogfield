{
  "name": "dogfield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ai:benchmark": "node --import tsx ai/benchmark.mjs",
    "ai:test": "node --import tsx --test ai/tests/environment.test.mjs && python3 -m unittest discover -s ai/tests -p 'test_*.py'",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "node --import tsx tests/run.mjs",
    "test:browser": "npm run build && node --import tsx server/tests/browser.mjs",
    "server": "npm run build && tsx server/start.ts",
    "live:game": "node tools/live-games/play-game.mjs",
    "live:parallel": "node tools/live-games/run-parallel.mjs",
    "live:melee": "node tools/live-games/play-melee.mjs",
    "live:melee:batch": "node tools/live-games/run-melee-batch.mjs",
    "live:melee:analyze": "node tools/live-games/analyze-melee.mjs",
    "live:protocols": "node tools/live-games/probe-protocols.mjs",
    "live:duel": "node tools/live-games/play-duel.mjs",
    "live:duel:analyze": "node tools/live-games/analyze-duel.mjs",
    "live:duel:campaign": "node --import tsx tools/live-games/run-duel-campaign.mjs",
    "live:dream": "node tools/live-games/play-game.mjs --dream",
    "live:dream:run": "node tools/live-games/run-dream.mjs",
    "live:dream:analyze": "node tools/live-games/analyze-dream.mjs",
    "logs:gzip": "node tools/live-games/gzip-logs.mjs",
    "verify:logs": "node --import tsx server/verify-logs.mjs",
    "verify:bot": "node --import tsx server/verify-bot-policy.mjs",
    "ranked:campaign": "node --import tsx tools/ranked-campaign.mjs",
    "flash:setup": "node tools/flash/setup.mjs",
    "flash:extract-2010-data": "python3 tools/flash/extract-2010-data.py",
    "flash:patch": "node tools/flash/patch.mjs",
    "test:flash:browser": "node --import tsx tools/flash/smoke.mjs",
    "test:flash:protocol": "node --import tsx tools/flash/protocol-smoke.mjs",
    "flash:audit-protocol": "node tools/flash/audit-protocol.mjs",
    "test:flash:multi-tab": "node --import tsx tools/flash/multi-tab-smoke.mjs",
    "test:flash:login": "node --import tsx tools/flash/login-smoke.mjs",
    "test:flash:parity": "node --import tsx tools/flash/parity.mjs",
    "test:flash:patches": "node --test tools/flash/scripts.test.mjs",
    "test:flash:audio": "node --import tsx tools/flash/audio-smoke.mjs",
    "apk:setup": "python3 tools/apk/patch.py --setup",
    "apk:patch": "python3 tools/apk/patch.py",
    "test:apk": "python3 tools/apk/test.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.1",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/sse": "0.6.1",
    "@fastify/static": "10.1.10",
    "@ruffle-rs/ruffle": "0.7.1",
    "fastify": "5.12.8",
    "tsx": "4.23.15",
    "ws": "8.23.0"
  }
}
